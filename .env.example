# Copy to `.env` before running the app: cp .env.example .env
#
# Expo inlines only EXPO_PUBLIC_* variables into the client bundle, so treat
# every value here as public — never put a server-side secret in this file.
# Neither value is required to run the app.

# Tags Sentry events. Use "production" for store builds.
EXPO_PUBLIC_APP_ENV=development

# Crash reporting. Leave empty to keep Sentry off entirely — v1.1 ships this
# way, so the only network call the app makes is the expo-updates check. A
# Sentry DSN is a write-only ingest key and is meant to be public, so shipping
# it in the bundle is expected. Turning this on for a release means updating
# docs/privacy.md and the Play Data safety form first.
EXPO_PUBLIC_SENTRY_DSN=

# Supabase — progress sync. Both values are public by design: the publishable
# key only grants what row level security allows, and every table in
# `supabase/schema.sql` restricts every row to `auth.uid() = user_id`. The
# secret key is a server credential and must never appear here or in a build.
# Leave both empty to run the app entirely offline, which is how it shipped.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat, wrapping Google Play Billing. The Android key is publishable — it
# identifies the app and grants nothing on its own — so shipping it in the
# bundle is expected. The `sk_` secret key is a server credential and must never
# appear here. Leave empty and the app cannot transact at all, which is how
# every build so far ships.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
