node_modules/
.expo/
# Web export, staged only to drive `npm run check:contrast`
.expo-web/
dist/
web-build/
coverage/

# Native projects generated by `expo prebuild`
/ios
/android

*.log
npm-debug.*
yarn-debug.*
yarn-error.*

.DS_Store
*.orig.*
*.tsbuildinfo

# Signing material — never commit these
*.p8
*.p12
*.key
*.jks
*.keystore
*.mobileprovision

# Local env. `.env.example` is the tracked template.
.env
.env.local
.env.*.local
!.env.example

# Editors
.idea/
*.iml

# Local agent tooling — session state, not project source. `skills/` is the
# exception: a run skill is checked-in tooling, not session scratch.
.claude/*
!.claude/skills/
.claude-flow/

# Google Play service account keys. The real one lives outside this repo, in
# ~/.config/otc-learn/ — this is here so that a copy made "just for a minute"
# cannot be committed by accident. It is a server credential: it can publish
# releases and read financial data.
*service-account*.json
play-service-account*.json

# Where downloads from a chat session land. The posters that matter live in
# marketing/social-v2/; this is the unpacked copy they arrived in.
Claude outputs/
