#!/bin/sh
#
# Run the same gate CI runs, before the commit exists.
#
# Cornerstone has had this since 18 September 2026, when an unused variable got
# past a partial check — `prettier` and `tsc` were run, `eslint` was not — and
# turned `main` red twice. Typecheck does not flag an unused local; lint does.
# This repo had no gate at all until 26 September 2026, which is the only reason
# the asymmetry is worth a comment: the larger of the two suites was the
# unprotected one.
#
# The gate is `npm run verify` and nothing narrower. Running a subset is exactly
# the mistake this exists to prevent.
#
# It costs about 32 seconds, most of it the 72 test suites. That is slower than
# Cornerstone's 11s; it is still cheaper than a red `main`.
#
# If it fails on something you did not touch, re-run before assuming you broke
# it. This suite failed intermittently on 26 September 2026 — one to three tests
# out of 1,150, in the React-timing-heavy suites — and then passed fourteen
# consecutive runs, including under full CPU saturation. The trigger was never
# identified. A second run is the cheap way to tell a flake from a real break.
#
# Bypass with `git commit --no-verify` when you genuinely mean to — a
# work-in-progress commit on a branch, say. Do not make a habit of it on `main`.

git_dir=$(git rev-parse --git-dir)

# A merge or rebase re-commits work that was already checked, often with
# conflict markers mid-resolution. Failing there is noise, not signal.
if [ -e "$git_dir/MERGE_HEAD" ] || [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then
  exit 0
fi

printf 'pre-commit: npm run verify — about 32s, skip with --no-verify\n'
start=$(date +%s)

if npm run verify >/tmp/otc-learn-precommit.log 2>&1; then
  printf 'pre-commit: passed in %ss\n' "$(( $(date +%s) - start ))"
  exit 0
fi

printf '\npre-commit: FAILED — the commit was not made.\n\n'

# Surface the ERRORS, not the tail. A plain `tail` buries the one error under
# whatever warnings came last, which is the kind of output people learn to
# ignore. eslint prefixes errors with "error", tsc with "error TS", and jest
# marks failures with a bullet.
if grep -nE "^\s*[0-9]+:[0-9]+\s+error|error TS[0-9]+|✕|●.*›|FAIL " /tmp/otc-learn-precommit.log > /tmp/otc-learn-precommit-errors.log 2>/dev/null &&
   [ -s /tmp/otc-learn-precommit-errors.log ]; then
  head -20 /tmp/otc-learn-precommit-errors.log
else
  # Nothing matched the known shapes — show the end and let the human read it.
  tail -25 /tmp/otc-learn-precommit.log
fi

printf '\nFull output: /tmp/otc-learn-precommit.log\n'
printf 'Fix it, or commit with --no-verify if you mean to.\n'
exit 1
